<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="350.0" prefWidth="350.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.DetalleAsientoController">
    <Text fill="#4d5e9e" layoutX="30.0" layoutY="40.0" text="Detalle del Asiento">
        <font><Font name="System Bold" size="22.0" /></font>
    </Text>

    <Label layoutX="30.0" layoutY="70.0" style="-fx-font-weight: bold;" text="ID Asiento:" />
    <Label fx:id="lblId" layoutX="150.0" layoutY="70.0" text="---" />

    <Label layoutX="30.0" layoutY="100.0" style="-fx-font-weight: bold;" text="Zona:" />
    <Label fx:id="lblZona" layoutX="150.0" layoutY="100.0" text="---" />

    <Label layoutX="30.0" layoutY="130.0" style="-fx-font-weight: bold;" text="Estado Actual:" />
    <Label fx:id="lblEstado" layoutX="150.0" layoutY="130.0" text="---" />

    <Label layoutX="30.0" layoutY="160.0" style="-fx-font-weight: bold;" text="Precio Base:" />
    <Label fx:id="lblPrecio" layoutX="150.0" layoutY="160.0" text="---" />

    <VBox fx:id="boxComprador" layoutX="30.0" layoutY="200.0" spacing="5.0" visible="false">
        <Label style="-fx-font-weight: bold; -fx-text-fill: #4c3984;" text="Información del Comprador:" />
        <Label fx:id="lblNombreUsuario" text="Nombre: ---" />
        <Label fx:id="lblIdUsuario" text="ID: ---" />
    </VBox>
    <Button layoutX="133.0" layoutY="300.0" onAction="#onCerrar" text="Cerrar" />
   <Button fx:id="btnBloquear" layoutX="208.0" layoutY="300.0" onAction="#onBloquear" text="Bloquear Asiento" />
</AnchorPane>
