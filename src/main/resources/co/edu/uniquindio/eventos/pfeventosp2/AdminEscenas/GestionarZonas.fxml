<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.GestionarZonasController">
    <Text fx:id="tituloRecintoText" fill="#4d5e9e" layoutX="30.0" layoutY="40.0" strokeType="OUTSIDE" strokeWidth="0.0"
          text="Zonas del Recinto">
        <font>
            <Font name="System Bold" size="26.0"/>
        </font>
    </Text>

    <Text fill="#4c3984" layoutX="30.0" layoutY="65.0" strokeType="OUTSIDE" strokeWidth="0.0"
          text="Haz clic sobre el nombre de una zona para editarla.">
        <font>
            <Font size="14.0"/>
        </font>
    </Text>

    <ScrollPane layoutX="30.0" layoutY="80.0" prefHeight="450.0" prefWidth="740.0"
                style="-fx-background-color: transparent;">
        <content>
            <VBox fx:id="mapaContenedor" alignment="TOP_CENTER" prefWidth="720.0" spacing="20.0"
                  style="-fx-padding: 10;"/>
        </content>
    </ScrollPane>

    <Button fx:id="volverButton" layoutX="30.0" layoutY="550.0" mnemonicParsing="false" onAction="#onVolver"
            prefHeight="30.0" prefWidth="100.0" text="Volver"/>
    <Button fx:id="nuevaZonaButton" layoutX="630.0" layoutY="550.0" mnemonicParsing="false" onAction="#onNuevaZona"
            prefHeight="30.0" prefWidth="140.0" style="-fx-background-color: #4d5e9e; -fx-text-fill: white;"
            text="+ Agregar Zona">
        <font>
            <Font name="System Bold" size="14.0"/>
        </font>
    </Button>
</AnchorPane>