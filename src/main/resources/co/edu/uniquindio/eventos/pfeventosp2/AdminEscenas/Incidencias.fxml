<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.IncidenciasController">
    <Text fill="#4d5e9e" layoutX="40.0" layoutY="60.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Gestión de Incidencias">
        <font>
            <Font name="System Bold" size="30.0" />
        </font>
    </Text>

    <HBox alignment="CENTER_LEFT" layoutX="40.0" layoutY="90.0" prefHeight="40.0" prefWidth="720.0" spacing="15.0">
        <children>
            <Text text="Filtrar por tipo:" />
            <ComboBox fx:id="tipoFiltro" prefWidth="150.0" promptText="Seleccionar tipo" />
            <Text text="Fecha:" />
            <DatePicker fx:id="fechaFiltro" prefWidth="150.0" />
            <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#onLimpiarFiltros" text="Limpiar" />
        </children>
    </HBox>

    <TableView fx:id="tblIncidencias" layoutX="40.0" layoutY="140.0" prefHeight="350.0" prefWidth="720.0">
        <columns>
            <TableColumn fx:id="idC" prefWidth="80.0" text="ID" />
            <TableColumn fx:id="tipoC" prefWidth="120.0" text="Tipo" />
            <TableColumn fx:id="fechaC" prefWidth="120.0" text="Fecha" />
            <TableColumn fx:id="entidadC" prefWidth="150.0" text="Entidad Afectada" />
            <TableColumn fx:id="descC" prefWidth="250.0" text="Descripción" />
        </columns>
    </TableView>

    <Button fx:id="btnNueva" layoutX="40.0" layoutY="510.0" mnemonicParsing="false" onAction="#onNuevaIncidencia" prefHeight="30.0" prefWidth="150.0" text="+ Nueva Incidencia" />
    <Button fx:id="btnDetalle" layoutX="600.0" layoutY="510.0" mnemonicParsing="false" onAction="#onVerDetalle" prefHeight="30.0" prefWidth="160.0" style="-fx-background-color: #4d5e9e; -fx-text-fill: white;" text="Ver Detalle Completo">
        <font>
            <Font name="System Bold" size="12.0" />
        </font>
    </Button>
   <Button fx:id="btnEliminar" layoutX="197.0" layoutY="510.0" mnemonicParsing="false" onAction="#onEliminarIncidencia" prefHeight="30.0" prefWidth="66.0" text="Eliminar" />
</AnchorPane>
