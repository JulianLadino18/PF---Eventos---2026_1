<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="450.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.NuevaZonaController">
    <Text fill="#4d5e9e" layoutX="40.0" layoutY="50.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Agregar Zona">
        <font>
            <Font name="System Bold" size="26.0"/>
        </font>
    </Text>

    <Text fill="#4c3984" layoutX="40.0" layoutY="100.0" strokeType="OUTSIDE" strokeWidth="0.0" text="ID Zona:">
        <font>
            <Font name="System Bold" size="14.0"/>
        </font>
    </Text>
    <Text fill="#4c3984" layoutX="40.0" layoutY="150.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nombre:">
        <font>
            <Font name="System Bold" size="14.0"/>
        </font>
    </Text>
    <Text fill="#4c3984" layoutX="40.0" layoutY="200.0" strokeType="OUTSIDE" strokeWidth="0.0"
          text="Capacidad (10-20):">
        <font>
            <Font name="System Bold" size="14.0"/>
        </font>
    </Text>
    <Text fill="#4c3984" layoutX="40.0" layoutY="250.0" strokeType="OUTSIDE" strokeWidth="0.0"
          text="Asientos por Fila:">
        <font>
            <Font name="System Bold" size="14.0"/>
        </font>
    </Text>
    <Text fill="#4c3984" layoutX="40.0" layoutY="300.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Precio Base ($):">
        <font>
            <Font name="System Bold" size="14.0"/>
        </font>
    </Text>

    <TextField fx:id="idZonaField" layoutX="180.0" layoutY="80.0" prefHeight="26.0" prefWidth="180.0"/>
    <TextField fx:id="nombreField" layoutX="180.0" layoutY="130.0" prefHeight="26.0" prefWidth="180.0"
               promptText="Ej: VIP"/>
    <TextField fx:id="capacidadField" layoutX="180.0" layoutY="180.0" prefHeight="26.0" prefWidth="180.0"
               promptText="Mín: 10, Máx: 20"/>
    <TextField fx:id="asientosFilaField" layoutX="180.0" layoutY="230.0" prefHeight="26.0" prefWidth="180.0"
               promptText="Ej: 5"/>
    <TextField fx:id="precioField" layoutX="180.0" layoutY="280.0" prefHeight="26.0" prefWidth="180.0"
               promptText="Ej: 50000"/>

    <Button fx:id="cancelarButton" layoutX="180.0" layoutY="360.0" mnemonicParsing="false" onAction="#onCancelar"
            prefHeight="30.0" prefWidth="80.0" text="Cancelar"/>
    <Button fx:id="guardarButton" layoutX="270.0" layoutY="360.0" mnemonicParsing="false" onAction="#onGuardar"
            prefHeight="30.0" prefWidth="90.0" style="-fx-background-color: #4d5e9e; -fx-text-fill: white;"
            text="Guardar">
        <font>
            <Font name="System Bold" size="12.0"/>
        </font>
    </Button>
</AnchorPane>