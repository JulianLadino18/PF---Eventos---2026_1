<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="450.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.NuevoUsuarioController">
    <Text fill="#4d5e9e" layoutX="40.0" layoutY="50.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nuevo Usuario">
        <font>
            <Font name="System Bold" size="26.0" />
        </font>
    </Text>

    <TextField fx:id="idField" layoutX="150.0" layoutY="80.0" prefWidth="200.0" promptText="Identificación" />
    <TextField fx:id="nombreField" layoutX="150.0" layoutY="130.0" prefWidth="200.0" promptText="Nombre completo" />
    <TextField fx:id="correoField" layoutX="150.0" layoutY="180.0" prefWidth="200.0" promptText="Correo electrónico" />
    <TextField fx:id="telefonoField" layoutX="150.0" layoutY="230.0" prefWidth="200.0" promptText="Teléfono" />
    <TextField fx:id="passwordField" layoutX="150.0" layoutY="280.0" prefWidth="200.0" promptText="Contraseña" />

    <Button fx:id="cancelarButton" layoutX="150.0" layoutY="350.0" mnemonicParsing="false" onAction="#onCancelar" prefWidth="80.0" text="Cancelar" />
    <Button fx:id="guardarButton" layoutX="250.0" layoutY="350.0" mnemonicParsing="false" onAction="#onGuardar" prefWidth="100.0" style="-fx-background-color: #4d5e9e; -fx-text-fill: white;" text="Registrar" />
   <Text fill="#4c3984" layoutX="16.0" layoutY="98.0" strokeType="OUTSIDE" strokeWidth="0.0" text="ID Usuario:">
      <font>
         <Font name="System Bold" size="14.0" />
      </font>
   </Text>
   <Text fill="#4c3984" layoutX="14.0" layoutY="145.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nombre Completo:">
      <font>
         <Font name="System Bold" size="14.0" />
      </font>
   </Text>
   <Text fill="#4c3984" layoutX="14.0" layoutY="198.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Correo Electrónico:">
      <font>
         <Font name="System Bold" size="14.0" />
      </font>
   </Text>
   <Text fill="#4c3984" layoutX="14.0" layoutY="248.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Teléfono:">
      <font>
         <Font name="System Bold" size="14.0" />
      </font>
   </Text>
   <Text fill="#4c3984" layoutX="14.0" layoutY="298.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Contraseña:">
      <font>
         <Font name="System Bold" size="14.0" />
      </font>
   </Text>
</AnchorPane>
