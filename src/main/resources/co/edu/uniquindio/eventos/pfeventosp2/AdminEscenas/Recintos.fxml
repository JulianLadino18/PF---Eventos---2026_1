<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.RecintosController">
    <Text fill="#4d5e9e" layoutX="40.0" layoutY="60.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Gestión de Recintos">
        <font>
            <Font name="System Bold" size="30.0" />
        </font>
    </Text>

    <TextField fx:id="buscarField" layoutX="40.0" layoutY="90.0" prefHeight="30.0" prefWidth="350.0" promptText="Buscar recinto por nombre o ciudad" />

    <TableView fx:id="tblRecintos" layoutX="40.0" layoutY="140.0" prefHeight="350.0" prefWidth="720.0">
        <columns>
            <TableColumn fx:id="idC" prefWidth="80.0" text="ID Recinto" />
            <TableColumn fx:id="nombreC" prefWidth="200.0" text="Nombre del Recinto" />
            <TableColumn fx:id="direccionC" prefWidth="200.0" text="Dirección" />
            <TableColumn fx:id="ciudadC" prefWidth="120.0" text="Ciudad" />
            <TableColumn fx:id="capacidadC" prefWidth="120.0" text="Capacidad Total" />
        </columns>
    </TableView>

    <Button fx:id="nuevoButton" layoutX="40.0" layoutY="510.0" mnemonicParsing="false" onAction="#onNuevo" prefHeight="30.0" prefWidth="120.0" text="Nuevo Recinto" />
    <Button fx:id="editarButton" layoutX="175.0" layoutY="510.0" mnemonicParsing="false" onAction="#onEditar" prefHeight="30.0" prefWidth="130.0" text="Editar Seleccionado" />
    <Button fx:id="eliminarButton" layoutX="320.0" layoutY="510.0" mnemonicParsing="false" onAction="#onEliminar" prefHeight="30.0" prefWidth="100.0" text="Eliminar" />

    <Button fx:id="gestionarZonasButton" layoutX="600.0" layoutY="510.0" mnemonicParsing="false" onAction="#onGestionarZonas" prefHeight="30.0" prefWidth="160.0" style="-fx-background-color: #4d5e9e; -fx-text-fill: white;" text="Gestionar Zonas">
        <font>
            <Font name="System Bold" size="14.0" />
        </font>
    </Button>
</AnchorPane>
