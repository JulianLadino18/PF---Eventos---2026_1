<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="350.0" prefWidth="400.0" styleClass="sidebar" stylesheets="@../Estilos/Estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.EditarAdminController">
    <Text fill="WHITE" layoutX="40.0" layoutY="50.0" styleClass="tittle" text="Editar Administrador" AnchorPane.leftAnchor="15.0" AnchorPane.topAnchor="15.0">
        <font>
            <Font name="System Bold" size="22.0" />
        </font>
    </Text>

    <Text fill="WHITE" layoutX="35.0" layoutY="103.0" styleClass="text" text="ID:" />
    <TextField fx:id="idField" editable="false" layoutX="150.0" layoutY="80.0" prefWidth="200.0" />

    <Text fill="WHITE" layoutX="35.0" layoutY="148.0" styleClass="text" text="Nombre:" />
    <TextField fx:id="nombreField" layoutX="150.0" layoutY="125.0" prefWidth="200.0" />

    <Text fill="WHITE" layoutX="33.0" layoutY="196.0" styleClass="text" text="Correo:" />
    <TextField fx:id="correoField" layoutX="150.0" layoutY="173.0" prefWidth="200.0" />

    <Text fill="WHITE" layoutX="35.0" layoutY="246.0" styleClass="text" text="Contraseña:" />
    <PasswordField fx:id="passwordField" editable="false" layoutX="150.0" layoutY="223.0" prefWidth="200.0" />

    <Button layoutX="350.0" layoutY="14.0" onAction="#onCancelar" prefWidth="33.0" styleClass="btn" text="X" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="15.0" />
    <Button layoutX="16.0" layoutY="288.0" onAction="#onGuardar" styleClass="btn" text="Guardar Cambios" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" />
</AnchorPane>
