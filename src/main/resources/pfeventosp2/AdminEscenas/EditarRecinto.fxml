<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" styleClass="sidebar" stylesheets="@../Estilos/Estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.EditarRecintoController">
    <children>
        <Text fill="WHITE" layoutX="40.0" layoutY="60.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="tittle" text="Editar Recinto" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0">
            <font>
                <Font name="System Bold" size="30.0" />
            </font>
        </Text>

        <Text fill="WHITE" layoutX="40.0" layoutY="120.0" strokeType="OUTSIDE" strokeWidth="0.0" text="ID del Recinto:">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Text>
        <Text fill="WHITE" layoutX="40.0" layoutY="170.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nombre:">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Text>
        <Text fill="WHITE" layoutX="40.0" layoutY="220.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Dirección:">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Text>
        <Text fill="WHITE" layoutX="40.0" layoutY="270.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Ciudad:">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Text>

        <Text fx:id="textId" fill="WHITE" layoutX="160.0" layoutY="120.0" strokeType="OUTSIDE" strokeWidth="0.0" text="ID_AQUI">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Text>

        <TextField fx:id="nombreField" layoutX="160.0" layoutY="150.0" prefHeight="26.0" prefWidth="280.0" />
        <TextField fx:id="direccionField" layoutX="160.0" layoutY="200.0" prefHeight="26.0" prefWidth="280.0" />
        <TextField fx:id="ciudadField" layoutX="160.0" layoutY="250.0" prefHeight="26.0" prefWidth="280.0" />

        <Button fx:id="cancelarButton" layoutX="422.0" layoutY="32.0" mnemonicParsing="false" onAction="#onCancelar" prefHeight="30.0" prefWidth="35.0" styleClass="btn" text="X" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0" />
        <Button fx:id="guardarButton" layoutX="23.0" layoutY="333.0" mnemonicParsing="false" onAction="#onGuardar" prefHeight="30.0" prefWidth="100.0" styleClass="btn" text="Guardar" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" />
    </children>
</AnchorPane>
