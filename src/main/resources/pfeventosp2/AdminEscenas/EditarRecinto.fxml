<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.EditarRecintoController">
    <children>
        <Text fill="#4d5e9e" layoutX="40.0" layoutY="60.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Editar Recinto">
            <font>
                <Font name="System Bold" size="30.0" />
            </font>
        </Text>

        <Text fill="#4c3984" layoutX="40.0" layoutY="120.0" strokeType="OUTSIDE" strokeWidth="0.0" text="ID del Recinto:">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Text>
        <Text fill="#4c3984" layoutX="40.0" layoutY="170.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nombre:">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Text>
        <Text fill="#4c3984" layoutX="40.0" layoutY="220.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Dirección:">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Text>
        <Text fill="#4c3984" layoutX="40.0" layoutY="270.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Ciudad:">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Text>

        <Text fx:id="textId" fill="#4c3984" layoutX="160.0" layoutY="120.0" strokeType="OUTSIDE" strokeWidth="0.0" text="ID_AQUI">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Text>

        <TextField fx:id="nombreField" layoutX="160.0" layoutY="150.0" prefHeight="26.0" prefWidth="280.0" />
        <TextField fx:id="direccionField" layoutX="160.0" layoutY="200.0" prefHeight="26.0" prefWidth="280.0" />
        <TextField fx:id="ciudadField" layoutX="160.0" layoutY="250.0" prefHeight="26.0" prefWidth="280.0" />

        <Button fx:id="cancelarButton" layoutX="220.0" layoutY="320.0" mnemonicParsing="false" onAction="#onCancelar" prefHeight="30.0" prefWidth="100.0" text="Cancelar" />
        <Button fx:id="guardarButton" layoutX="340.0" layoutY="320.0" mnemonicParsing="false" onAction="#onGuardar" prefHeight="30.0" prefWidth="100.0" text="Guardar" />
    </children>
</AnchorPane>