<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="450.0" prefWidth="400.0" styleClass="sidebar" stylesheets="@../Estilos/Estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.EditarUsuarioController">
    <Text fill="WHITE" layoutX="40.0" layoutY="50.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="tittle" text="Editar Usuario" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0">
        <font>
            <Font name="System Bold" size="26.0" />
        </font>
    </Text>

    <Text fill="WHITE" layoutX="40.0" layoutY="100.0" styleClass="text" text="ID:" />
    <TextField fx:id="idField" editable="false" layoutX="150.0" layoutY="80.0" prefWidth="200.0" />

    <Text fill="WHITE" layoutX="40.0" layoutY="150.0" styleClass="text" text="Nombre:" />
    <TextField fx:id="nombreField" layoutX="150.0" layoutY="130.0" prefWidth="200.0" />

    <Text fill="WHITE" layoutX="40.0" layoutY="200.0" styleClass="text" text="Correo:" />
    <TextField fx:id="correoField" layoutX="150.0" layoutY="180.0" prefWidth="200.0" />

    <Text fill="WHITE" layoutX="40.0" layoutY="250.0" styleClass="text" text="Teléfono:" />
    <TextField fx:id="telefonoField" layoutX="150.0" layoutY="230.0" prefWidth="200.0" />

    <Text fill="WHITE" layoutX="40.0" layoutY="300.0" styleClass="text" text="Contraseña:" />
    <PasswordField fx:id="passwordField" editable="false" layoutX="150.0" layoutY="280.0" prefWidth="200.0" />

    <Button layoutX="333.0" layoutY="19.0" onAction="#onCancelar" prefWidth="33.0" styleClass="btn" text="X" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0" />
    <Button layoutX="250.0" layoutY="350.0" onAction="#onGuardar" prefWidth="83.0" styleClass="btn" text="Guardar" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" />
</AnchorPane>
