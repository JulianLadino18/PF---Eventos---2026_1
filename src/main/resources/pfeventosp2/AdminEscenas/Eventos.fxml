<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.EventosController">
    <Text fill="#4d5e9e" layoutX="60.0" layoutY="63.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Gestión de Eventos">
        <font>
          <Font name="System Bold" size="37.0" />
        </font>
    </Text>
    <TableView fx:id="tblEventos" layoutX="14.0" layoutY="142.0" prefHeight="272.0" prefWidth="947.0">
      <columns>
          <TableColumn fx:id="idC" prefWidth="56.800018310546875" text="ID" />
          <TableColumn fx:id="nombreC" prefWidth="143.19998168945312" text="Nombre del Evento" />
          <TableColumn fx:id="categoriaC" prefWidth="124.00001525878906" text="Categoría" />
         <TableColumn fx:id="descC" prefWidth="124.00001525878906" text="Descripción" />
          <TableColumn fx:id="fechaC" prefWidth="84.79998779296875" text="Fecha" />
          <TableColumn fx:id="horaC" prefWidth="96.79998779296875" text="Hora" />
          <TableColumn fx:id="ciudadC" prefWidth="97.5999755859375" text="Ciudad" />
          <TableColumn fx:id="recintoC" prefWidth="83.20001220703125" text="Recinto" />
          <TableColumn fx:id="estadoC" maxWidth="111.20001220703125" prefWidth="84.0" text="Estado" />
          <TableColumn fx:id="disponibilidadC" prefWidth="117.60003662109375" text="Disponibilidad / Mapa" />
      </columns>
    </TableView>
    <Button fx:id="editarButton" layoutX="835.0" layoutY="448.0" mnemonicParsing="false" onAction="#onEditar" text="Editar Seleccionado" />
    <Button fx:id="eliminarButton" layoutX="823.0" layoutY="484.0" mnemonicParsing="false" onAction="#onEliminarEvento" text="Eliminar Seleccionado" />
    <Button fx:id="mapaComboB" layoutX="755.0" layoutY="552.0" mnemonicParsing="false" onAction="#onMapa" text="Ver Mapa de Asientos / Disponiblidad" />
    <Button fx:id="nuevoButton" layoutX="852.0" layoutY="101.0" mnemonicParsing="false" onAction="#onNuevoEvento" text="Nuevo Evento +" />
    <TextField fx:id="buscarField" layoutX="60.0" layoutY="102.0" promptText="Buscar Eventos" />
    <ComboBox fx:id="cambiarEstadoComboB" layoutX="705.0" layoutY="518.0" prefWidth="150.0" promptText="Cambiar Estado" />
    <Text fill="#4c3984" layoutX="581.0" layoutY="536.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Cambiar Estado:">
        <font>
          <Font name="System Bold" size="15.0" />
        </font>
    </Text>
   <ComboBox fx:id="filtrarComboB" layoutX="665.0" layoutY="101.0" prefHeight="26.0" prefWidth="163.0" promptText="Filtrar por  Categoría" />
   <Button fx:id="aplicarButton" layoutX="863.0" layoutY="518.0" mnemonicParsing="false" onAction="#onAplicarEstado" text="Aplicar Estado" />
</AnchorPane>
