<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="579.0" prefWidth="839.0" stylesheets="@../Estilos/Estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.EventosController">
    <Text fill="WHITE" layoutX="14.0" layoutY="41.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="tittle" text="Gestión de Eventos" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0">
        <font>
          <Font name="System Bold" size="37.0" />
        </font>
    </Text>
    <TableView fx:id="tblEventos" layoutX="14.0" layoutY="142.0" prefHeight="317.0" prefWidth="829.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0">
      <columns>
          <TableColumn fx:id="idC" prefWidth="37.0" text="ID" />
          <TableColumn fx:id="nombreC" prefWidth="125.0" text="Nombre del Evento" />
          <TableColumn fx:id="categoriaC" prefWidth="78.0" text="Categoría" />
         <TableColumn fx:id="descC" prefWidth="84.0" text="Descripción" />
          <TableColumn fx:id="fechaC" prefWidth="59.0" text="Fecha" />
          <TableColumn fx:id="horaC" prefWidth="48.0" text="Hora" />
          <TableColumn fx:id="ciudadC" prefWidth="77.0" text="Ciudad" />
          <TableColumn fx:id="recintoC" prefWidth="78.0" text="Recinto" />
          <TableColumn fx:id="estadoC" maxWidth="166.0" minWidth="0.0" prefWidth="64.0" text="Estado" />
          <TableColumn fx:id="disponibilidadC" prefWidth="179.0" text="Disponibilidad / Mapa" />
      </columns>
    </TableView>
   <HBox layoutX="14.0" layoutY="100.0" prefHeight="42.0" prefWidth="829.0" AnchorPane.leftAnchor="5.0">
      <children>
          <TextField fx:id="buscarField" promptText="Buscar Eventos">
            <HBox.margin>
               <Insets right="300.0" />
            </HBox.margin>
         </TextField>
          <Button fx:id="nuevoButton" mnemonicParsing="false" onAction="#onNuevoEvento" styleClass="btn" text="Nuevo Evento +">
            <HBox.margin>
               <Insets right="10.0" />
            </HBox.margin>
         </Button>
         <ComboBox fx:id="filtrarComboB" prefHeight="26.0" prefWidth="209.0" promptText="Filtrar por  Categoría" styleClass="btn">
            <HBox.margin>
               <Insets />
            </HBox.margin>
         </ComboBox>
      </children>
   </HBox>
   <HBox layoutX="11.0" layoutY="523.0" prefHeight="42.0" prefWidth="817.0">
      <children>
          <Button fx:id="editarButton" mnemonicParsing="false" onAction="#onEditar" prefWidth="173.0" styleClass="btn" text="Editar Seleccionado">
            <HBox.margin>
               <Insets right="5.0" />
            </HBox.margin>
         </Button>
          <Button fx:id="eliminarButton" mnemonicParsing="false" onAction="#onEliminarEvento" styleClass="btn" text="Eliminar Seleccionado">
            <HBox.margin>
               <Insets right="175.0" />
            </HBox.margin>
         </Button>
          <Button fx:id="mapaComboB" mnemonicParsing="false" onAction="#onMapa" styleClass="btn" text="Ver Mapa de Asientos / Disponiblidad" />
      </children>
   </HBox>
   <HBox alignment="CENTER_LEFT" layoutX="14.0" layoutY="470.0" prefHeight="42.0" prefWidth="811.0">
      <children>
          <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="tittle" text="Cambiar Estado:">
              <font>
                <Font name="System Bold" size="15.0" />
              </font>
            <HBox.margin>
               <Insets right="5.0" />
            </HBox.margin>
          </Text>
          <ComboBox fx:id="cambiarEstadoComboB" prefWidth="173.0" promptText="Cambiar Estado" styleClass="btn">
            <HBox.margin>
               <Insets right="5.0" />
            </HBox.margin>
         </ComboBox>
         <Button fx:id="aplicarButton" mnemonicParsing="false" onAction="#onAplicarEstado" styleClass="btn" text="Aplicar Estado">
            <HBox.margin>
               <Insets right="5.0" />
            </HBox.margin>
         </Button>
      </children>
   </HBox>
</AnchorPane>
