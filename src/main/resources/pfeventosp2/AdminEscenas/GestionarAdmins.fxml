<AnchorPane prefHeight="579.0" prefWidth="839.0" styleClass="content" stylesheets="@../Estilos/Estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.GestionarAdminsController">
    <Text fill="WHITE" layoutX="40.0" layoutY="50.0" styleClass="tittle" text="Gestión de Administradores" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0">
        <font>
            <Font name="System Bold" size="26.0" />
        </font>
    </Text>

    <TableView fx:id="tblAdmins" layoutX="40.0" layoutY="136.0" prefHeight="370.0" prefWidth="836.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0">
