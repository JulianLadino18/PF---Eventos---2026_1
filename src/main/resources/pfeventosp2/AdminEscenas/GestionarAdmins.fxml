<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="500.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.GestionarAdminsController">
    <Text fill="#4d5e9e" layoutX="40.0" layoutY="50.0" text="Gestión de Administradores">
        <font>
            <Font name="System Bold" size="26.0" />
        </font>
    </Text>

    <TableView fx:id="tblAdmins" layoutX="40.0" layoutY="80.0" prefHeight="300.0" prefWidth="520.0">
        <columns>
            <TableColumn fx:id="idC" prefWidth="80.0" text="ID" />
            <TableColumn fx:id="nombreC" prefWidth="180.0" text="Nombre" />
            <TableColumn fx:id="correoC" prefWidth="257.60003662109375" text="Correo" />
        </columns>
    </TableView>

    <Button layoutX="40.0" layoutY="400.0" onAction="#onNuevo" text="+ Nuevo Admin" />
    <Button layoutX="241.0" layoutY="400.0" onAction="#onEliminar" style="-fx-background-color: #d9534f; -fx-text-fill: white;" text="Eliminar" />
   <Button layoutX="148.0" layoutY="400.0" onAction="#onEditar" text="Editar Admin" />
</AnchorPane>
