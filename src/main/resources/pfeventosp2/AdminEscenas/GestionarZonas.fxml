                <Button fx:id="volverButton" layoutX="730.0" layoutY="19.0" mnemonicParsing="false" onAction="#onVolver" prefHeight="30.0" prefWidth="37.0" styleClass="btn" text="X" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0" />
