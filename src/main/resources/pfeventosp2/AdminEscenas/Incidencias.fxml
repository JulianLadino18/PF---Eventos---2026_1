<AnchorPane prefHeight="579.0" prefWidth="839.0" styleClass="content" stylesheets="@../Estilos/Estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.IncidenciasController">
    <Text fill="WHITE" layoutX="5.0" layoutY="48.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="tittle" text="Gestión de Incidencias" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0">
        <font>
            <Font name="System Bold" size="30.0" />
        </font>
    </Text>

    <HBox alignment="CENTER_LEFT" layoutX="5.0" layoutY="89.0" prefHeight="40.0" prefWidth="720.0" spacing="15.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="4.599999999999909">
        <children>
            <Text fill="WHITE" styleClass="text" text="Filtrar por tipo:" />
            <ComboBox fx:id="tipoFiltro" prefWidth="169.0" promptText="Seleccionar tipo" styleClass="btn" />
            <Text fill="WHITE" styleClass="text" text="Fecha:" />
