<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.MapaAsientosEventoController">

    <Text fx:id="tituloEventoText" fill="#4d5e9e" layoutX="30.0" layoutY="40.0" text="Disponibilidad: [Nombre Evento]">
        <font><Font name="System Bold" size="24.0"/></font>
    </Text>

    <Text fx:id="subtituloRecintoText" fill="#4c3984" layoutX="30.0" layoutY="65.0" text="Recinto: [Nombre Recinto] - Haz clic en un asiento para ver su detalle.">
        <font><Font size="14.0"/></font>
    </Text>

    <HBox layoutX="30.0" layoutY="85.0" spacing="15.0" alignment="CENTER_LEFT">
        <Label text="Disponible" style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-padding: 3 8 3 8; -fx-background-radius: 3;"/>
        <Label text="Vendido" style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-padding: 3 8 3 8; -fx-background-radius: 3;"/>
        <Label text="Reservado" style="-fx-background-color: #ff9800; -fx-text-fill: white; -fx-padding: 3 8 3 8; -fx-background-radius: 3;"/>
        <Label text="Bloqueado" style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-padding: 3 8 3 8; -fx-background-radius: 3;"/>
    </HBox>

    <ScrollPane layoutX="30.0" layoutY="120.0" prefHeight="450.0" prefWidth="790.0" style="-fx-background-color: transparent;">
        <content>
            <VBox fx:id="mapaContenedor" alignment="TOP_CENTER" prefWidth="770.0" spacing="20.0" style="-fx-padding: 10;"/>
        </content>
    </ScrollPane>

    <Button layoutX="30.0" layoutY="590.0" onAction="#onVolver" prefWidth="100.0" text="Volver"/>
</AnchorPane>