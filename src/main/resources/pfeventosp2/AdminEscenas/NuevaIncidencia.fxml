<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="400.0" styleClass="sidebar" stylesheets="@../Estilos/Estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.NuevaIncidenciaController">
    <Text fill="WHITE" layoutX="40.0" layoutY="40.0" styleClass="tittle" text="Registrar Incidencia" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0">
        <font>
            <Font name="System Bold" size="22.0" />
        </font>
    </Text>

    <TextField fx:id="idField" layoutX="150.0" layoutY="70.0" promptText="ID Incidencia" />
    <ComboBox fx:id="tipoCombo" layoutX="150.0" layoutY="110.0" prefWidth="174.0" promptText="Tipo" styleClass="btn" />
    <ComboBox fx:id="entidadCombo" layoutX="150.0" layoutY="150.0" prefWidth="174.0" promptText="Entidad" styleClass="btn" />
    <TextField fx:id="idEntidadField" layoutX="150.0" layoutY="190.0" promptText="ID Entidad Afectada" />
    <TextArea fx:id="descArea" layoutX="40.0" layoutY="230.0" prefHeight="100.0" prefWidth="320.0" promptText="Descripción detallada..." />

    <Button layoutX="150.0" layoutY="350.0" onAction="#onCancelar" prefHeight="30.0" prefWidth="29.0" styleClass="btn" text="x" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0" />
    <Button layoutX="250.0" layoutY="350.0" onAction="#onGuardar" styleClass="btn" text="Guardar" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" />
   <Text fill="WHITE" layoutX="40.0" layoutY="88.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="text" text="ID Incidencia:">
      <font>
         <Font name="System Bold" size="14.0" />
      </font>
   </Text>
   <Text fill="WHITE" layoutX="40.0" layoutY="128.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="text" text="Tipo:">
      <font>
         <Font name="System Bold" size="14.0" />
      </font>
   </Text>
   <Text fill="WHITE" layoutX="40.0" layoutY="168.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="text" text="Entidad:">
      <font>
         <Font name="System Bold" size="14.0" />
      </font>
   </Text>
   <Text fill="WHITE" layoutX="40.0" layoutY="205.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="text" text="ID Entidad:">
      <font>
         <Font name="System Bold" size="14.0" />
      </font>
   </Text>
</AnchorPane>
