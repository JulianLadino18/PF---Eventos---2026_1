<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.NuevaIncidenciaController">
    <Text fill="#4d5e9e" layoutX="40.0" layoutY="40.0" text="Registrar Incidencia">
        <font>
            <Font name="System Bold" size="22.0" />
        </font>
    </Text>

    <TextField fx:id="idField" layoutX="150.0" layoutY="70.0" promptText="ID Incidencia" />
    <ComboBox fx:id="tipoCombo" layoutX="150.0" layoutY="110.0" prefWidth="150.0" promptText="Tipo" />
    <ComboBox fx:id="entidadCombo" layoutX="150.0" layoutY="150.0" prefWidth="150.0" promptText="Entidad" />
    <TextField fx:id="idEntidadField" layoutX="150.0" layoutY="190.0" promptText="ID Entidad Afectada" />
    <TextArea fx:id="descArea" layoutX="40.0" layoutY="230.0" prefHeight="100.0" prefWidth="320.0" promptText="Descripción detallada..." />

    <Button layoutX="150.0" layoutY="350.0" onAction="#onCancelar" text="Cancelar" />
    <Button layoutX="250.0" layoutY="350.0" onAction="#onGuardar" style="-fx-background-color: #4d5e9e; -fx-text-fill: white;" text="Guardar" />
   <Text fill="#4c3984" layoutX="40.0" layoutY="88.0" strokeType="OUTSIDE" strokeWidth="0.0" text="ID Incidencia:">
      <font>
         <Font name="System Bold" size="14.0" />
      </font>
   </Text>
   <Text fill="#4c3984" layoutX="40.0" layoutY="128.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Tipo:">
      <font>
         <Font name="System Bold" size="14.0" />
      </font>
   </Text>
   <Text fill="#4c3984" layoutX="40.0" layoutY="168.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Entidad:">
      <font>
         <Font name="System Bold" size="14.0" />
      </font>
   </Text>
   <Text fill="#4c3984" layoutX="40.0" layoutY="205.0" strokeType="OUTSIDE" strokeWidth="0.0" text="ID Entidad:">
      <font>
         <Font name="System Bold" size="14.0" />
      </font>
   </Text>
</AnchorPane>
