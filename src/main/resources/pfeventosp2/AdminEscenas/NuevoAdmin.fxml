<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="350.0" prefWidth="400.0" styleClass="sidebar" stylesheets="@../Estilos/Estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.NuevoAdminController">
    <Text fill="WHITE" layoutX="40.0" layoutY="50.0" styleClass="tittle" text="Registrar Administrador" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0">
        <font>
            <Font name="System Bold" size="22.0" />
        </font>
    </Text>

    <TextField fx:id="idField" layoutX="150.0" layoutY="80.0" prefWidth="200.0" promptText="ID único" />
    <TextField fx:id="nombreField" layoutX="150.0" layoutY="120.0" prefWidth="200.0" promptText="Nombre completo" />
    <TextField fx:id="correoField" layoutX="150.0" layoutY="160.0" prefWidth="200.0" promptText="Correo electrónico" />
    <TextField fx:id="passwordField" layoutX="150.0" layoutY="200.0" prefWidth="200.0" promptText="Contraseña" />

    <Button layoutX="150.0" layoutY="280.0" onAction="#onCancelar" prefHeight="30.0" prefWidth="30.0" styleClass="btn" text="X" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0" />
    <Button layoutX="250.0" layoutY="280.0" onAction="#onGuardar" styleClass="btn" text="Guardar" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" />

    <Text fill="WHITE" layoutX="40.0" layoutY="98.0" styleClass="text" text="ID:" />
    <Text fill="WHITE" layoutX="40.0" layoutY="138.0" styleClass="text" text="Nombre:" />
    <Text fill="WHITE" layoutX="40.0" layoutY="178.0" styleClass="text" text="Correo:" />
    <Text fill="WHITE" layoutX="40.0" layoutY="218.0" styleClass="text" text="Contraseña:" />
</AnchorPane>
