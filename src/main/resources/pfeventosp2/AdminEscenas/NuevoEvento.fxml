<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.NuevoEventoController">
    <!-- Título -->
    <Text fill="#4d5e9e" layoutX="63.0" layoutY="67.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Nuevo Evento">
        <font>
            <Font name="System Bold" size="37.0"/>
        </font>
    </Text>

    <!-- Etiquetas (Labels) -->
    <Text fill="#4c3984" layoutX="63.0" layoutY="109.0" strokeType="OUTSIDE" strokeWidth="0.0" text="ID del Evento:">
        <font>
            <Font name="System Bold" size="15.0"/>
        </font>
    </Text>
    <Text fill="#4c3984" layoutX="65.0" layoutY="140.0" strokeType="OUTSIDE" strokeWidth="0.0"
          text="Nombre del Evento:">
        <font>
            <Font name="System Bold" size="15.0"/>
        </font>
    </Text>
    <Text fill="#4c3984" layoutX="63.0" layoutY="172.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Categoría:">
        <font>
            <Font name="System Bold" size="15.0"/>
        </font>
    </Text>
    <Text fill="#4c3984" layoutX="56.0" layoutY="221.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Descripción:">
        <font>
            <Font name="System Bold" size="15.0"/>
        </font>
    </Text>
    <Text fill="#4c3984" layoutX="65.0" layoutY="271.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Ciudad:">
        <font>
            <Font name="System Bold" size="15.0"/>
        </font>
    </Text>

    <!-- Campos de Entrada (Inputs) -->
    <!-- CAMBIO: Ahora el ID es un TextField para poder ingresar el nuevo código -->
    <TextField fx:id="idField" layoutX="245.0" layoutY="90.0" prefHeight="26.0" prefWidth="290.0"
               promptText="Ej: E002"/>

    <TextField fx:id="nombreField" layoutX="245.0" layoutY="121.0" prefHeight="26.0" prefWidth="290.0"/>
    <ComboBox fx:id="categoriaComboB" layoutX="245.0" layoutY="154.0" prefWidth="150.0"/>

    <!-- CAMBIO: Corregido el nombre a descripcionField -->
    <TextField fx:id="descripcionField" layoutX="245.0" layoutY="188.0" prefHeight="54.0" prefWidth="475.0"/>

    <TextField fx:id="ciudadField" layoutX="245.0" layoutY="252.0" prefHeight="26.0" prefWidth="290.0"/>
    <DatePicker fx:id="datePicker" layoutX="238.0" layoutY="296.0"/>

    <!-- Sección de Fecha y Hora -->
    <Text fill="#4c3984" layoutX="65.0" layoutY="314.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Fecha:">
        <font>
            <Font name="System Bold" size="15.0"/>
        </font>
    </Text>
    <Text fill="#4c3984" layoutX="65.0" layoutY="349.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Hora:">
        <font>
            <Font name="System Bold" size="15.0"/>
        </font>
    </Text>
    <ComboBox fx:id="horaComboB" layoutX="302.0" layoutY="330.0" prefHeight="26.0" prefWidth="86.0"/>
    <ComboBox fx:id="minutoComboB" layoutX="506.0" layoutY="330.0" prefHeight="26.0" prefWidth="86.0"/>
    <Text fill="#4c3984" layoutX="245.0" layoutY="349.0" strokeType="OUTSIDE" strokeWidth="0.0" text="HH:">
        <font>
            <Font name="System Bold" size="15.0"/>
        </font>
    </Text>
    <Text fill="#4c3984" layoutX="461.0" layoutY="349.0" strokeType="OUTSIDE" strokeWidth="0.0" text="MM:">
        <font>
            <Font name="System Bold" size="15.0"/>
        </font>
    </Text>

    <!-- Sección de Política y Recinto -->
    <Text fill="#4c3984" layoutX="65.0" layoutY="389.0" strokeType="OUTSIDE" strokeWidth="0.0"
          text="Política Cancelación:">
        <font>
            <Font name="System Bold" size="15.0"/>
        </font>
    </Text>
    <ComboBox fx:id="politicaComboB" layoutX="238.0" layoutY="371.0" prefWidth="150.0"/>
    <Text fill="#4c3984" layoutX="65.0" layoutY="435.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Recinto:">
        <font>
            <Font name="System Bold" size="15.0"/>
        </font>
    </Text>
    <ComboBox fx:id="recintoComboB" layoutX="238.0" layoutY="417.0" prefWidth="150.0"/>

    <!-- Botones de Acción -->
    <Button fx:id="cancelarButton" layoutX="530.0" layoutY="484.0" mnemonicParsing="false" onAction="#onCancelar"
            prefHeight="26.0" prefWidth="86.0" text="Cancelar"/>
    <Button fx:id="crearButton" layoutX="640.0" layoutY="484.0" mnemonicParsing="false" onAction="#onCrear"
            text="Crear Evento"/>
</AnchorPane>
