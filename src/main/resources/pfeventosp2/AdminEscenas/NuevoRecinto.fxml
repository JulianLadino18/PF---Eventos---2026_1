<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" styleClass="sidebar" stylesheets="@../Estilos/Estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.NuevoRecintoController">
    <children>
        <!-- Título -->
        <Text fill="WHITE" layoutX="40.0" layoutY="60.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="tittle" text="Nuevo Recinto" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0">
            <font>
                <Font name="System Bold" size="30.0" />
            </font>
        </Text>

        <!-- Etiquetas -->
        <Text fill="WHITE" layoutX="40.0" layoutY="120.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="text" text="ID del Recinto:">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Text>
        <Text fill="WHITE" layoutX="40.0" layoutY="170.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="text" text="Nombre:">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Text>
        <Text fill="WHITE" layoutX="40.0" layoutY="220.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="text" text="Dirección:">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Text>
        <Text fill="WHITE" layoutX="40.0" layoutY="270.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="text" text="Ciudad:">
            <font>
                <Font name="System Bold" size="15.0" />
            </font>
        </Text>

        <!-- Campos de Texto -->
        <TextField fx:id="idField" layoutX="160.0" layoutY="100.0" prefHeight="26.0" prefWidth="280.0" />
        <TextField fx:id="nombreField" layoutX="160.0" layoutY="150.0" prefHeight="26.0" prefWidth="280.0" promptText="Ej: Estadio Centenario" />
        <TextField fx:id="direccionField" layoutX="160.0" layoutY="200.0" prefHeight="26.0" prefWidth="280.0" promptText="Ej: Cra. 18 # 12-34" />
        <TextField fx:id="ciudadField" layoutX="160.0" layoutY="250.0" prefHeight="26.0" prefWidth="280.0" promptText="Ej: Armenia" />

        <!-- Botones de Acción -->
        <Button fx:id="cancelarButton" layoutX="220.0" layoutY="320.0" mnemonicParsing="false" onAction="#onCancelar" prefHeight="30.0" prefWidth="30.0" styleClass="btn" text="X" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="20.0" />
        <Button fx:id="crearButton" layoutX="300.0" layoutY="320.0" mnemonicParsing="false" onAction="#onCrear" prefHeight="30.0" prefWidth="140.0" styleClass="btn" text="Crear Recinto" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" />
    </children>
</AnchorPane>
