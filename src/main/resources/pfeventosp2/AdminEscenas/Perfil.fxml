<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="604.0" prefWidth="746.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.PerfilAdminController">
    <children>
        <Label layoutX="50.0" layoutY="30.0" text="Mi Perfil" textFill="#4d5e9e">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
        </Label>

        <VBox layoutX="50.0" layoutY="80.0" prefWidth="300.0" spacing="15.0">
            <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Datos Personales" />

            <Label text="ID (Solo lectura):" />
            <TextField fx:id="txtId" editable="false" style="-fx-background-color: #e9ecef;" />

            <Label text="Nombre Completo:" />
            <TextField fx:id="txtNombre" promptText="Tu nombre" />

            <Label text="Correo Electrónico:" />
            <TextField fx:id="txtCorreo" promptText="Tu correo" />

            <Button onAction="#onActualizarDatos" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Actualizar Datos" />
        </VBox>

        <VBox layoutX="400.0" layoutY="80.0" prefWidth="300.0" spacing="15.0" style="-fx-border-color: #ccc; -fx-border-radius: 5; -fx-padding: 15;">
            <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Cambiar Contraseña" />

            <Label text="Contraseña Actual:" />
            <PasswordField fx:id="txtContrasenaActual" promptText="Ingresa contraseña actual" />

            <Label text="Nueva Contraseña:" />
            <PasswordField fx:id="txtNuevaContrasena" promptText="Ingresa la nueva contraseña" />

            <Label text="Confirmar Nueva Contraseña:" />
            <PasswordField fx:id="txtConfirmarContrasena" promptText="Repite la nueva contraseña" />

            <Button onAction="#onCambiarContrasena" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Cambiar Contraseña" />
        </VBox>
    </children>
</AnchorPane>
