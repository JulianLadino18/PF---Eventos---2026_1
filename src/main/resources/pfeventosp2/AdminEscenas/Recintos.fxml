<AnchorPane prefHeight="579.0" prefWidth="839.0" styleClass="content" stylesheets="@../Estilos/Estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.RecintosController">
    <Text fill="WHITE" layoutX="14.0" layoutY="55.0" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="tittle" text="Gestión de Recintos" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="20.0">
        <font>
            <Font name="System Bold" size="30.0" />
        </font>
    </Text>

    <TableView fx:id="tblRecintos" layoutX="40.0" layoutY="140.0" prefHeight="371.0" prefWidth="793.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0">
        <columns>
            <TableColumn fx:id="idC" prefWidth="70.3999879837038" text="ID Recinto" />
            <TableColumn fx:id="nombreC" prefWidth="216.80001831054688" text="Nombre del Recinto" />
            <TableColumn fx:id="direccionC" prefWidth="193.60003662109375" text="Dirección" />
            <TableColumn fx:id="ciudadC" prefWidth="168.800048828125" text="Ciudad" />
            <TableColumn fx:id="capacidadC" prefWidth="176.800048828125" text="Capacidad Total" />
        </columns>
    </TableView>
   <HBox layoutY="520.0" prefHeight="43.0" prefWidth="779.0" AnchorPane.leftAnchor="5.0" AnchorPane.rightAnchor="5.0">
      <children>
          <Button fx:id="editarButton" mnemonicParsing="false" onAction="#onEditar" prefHeight="30.0" prefWidth="179.0" styleClass="btn" text="Editar Seleccionado">
            <HBox.margin>
               <Insets right="5.0" />
            </HBox.margin>
         </Button>
          <Button fx:id="eliminarButton" mnemonicParsing="false" onAction="#onEliminar" prefHeight="30.0" prefWidth="100.0" styleClass="btn" text="Eliminar">
            <HBox.margin>
               <Insets right="385.0" />
            </HBox.margin>
         </Button>
      
          <Button fx:id="gestionarZonasButton" mnemonicParsing="false" onAction="#onGestionarZonas" prefHeight="30.0" prefWidth="160.0" styleClass="btn" text="Gestionar Zonas">
              <font>
