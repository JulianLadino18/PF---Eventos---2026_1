              </font>
          </Button>
      </children>
   </HBox>
   <HBox layoutX="5.0" layoutY="98.0" prefHeight="35.0" prefWidth="829.0">
      <children>
      
          <TextField fx:id="buscarField" prefHeight="30.0" prefWidth="350.0" promptText="Buscar recinto por nombre o ciudad">
            <HBox.margin>
               <Insets right="325.0" />
            </HBox.margin>
         </TextField>
      
                <Button fx:id="nuevoButton" mnemonicParsing="false" onAction="#onNuevo" prefHeight="30.0" prefWidth="154.0" styleClass="btn" text="Nuevo Recinto +" />
      </children>
