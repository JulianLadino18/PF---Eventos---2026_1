<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.UsuariosController">
    <Text fill="#4d5e9e" layoutX="40.0" layoutY="60.0" strokeType="OUTSIDE" strokeWidth="0.0"
          text="Gestión de Usuarios">
        <font>
            <Font name="System Bold" size="30.0"/>
        </font>
    </Text>

    <TextField fx:id="buscarField" layoutX="40.0" layoutY="90.0" prefHeight="30.0" prefWidth="350.0"
               promptText="Buscar usuario por nombre o correo..."/>

    <TableView fx:id="tblUsuarios" layoutX="40.0" layoutY="140.0" prefHeight="350.0" prefWidth="720.0">
        <columns>
            <TableColumn fx:id="idC" prefWidth="100.0" text="Identificación" />
            <TableColumn fx:id="nombreC" prefWidth="200.0" text="Nombre Completo" />
            <TableColumn fx:id="correoC" prefWidth="200.0" text="Correo Electrónico" />
            <TableColumn fx:id="telefonoC" prefWidth="110.0" text="Teléfono" />
            <TableColumn fx:id="gastosC" prefWidth="110.0" text="Gastos Totales" />
        </columns>
    </TableView>

    <Button fx:id="nuevoButton" layoutX="40.0" layoutY="510.0" mnemonicParsing="false" onAction="#onNuevo"
            prefHeight="30.0" prefWidth="120.0" text="Nuevo Usuario"/>
    <Button fx:id="editarButton" layoutX="175.0" layoutY="510.0" mnemonicParsing="false" onAction="#onEditar"
            prefHeight="30.0" prefWidth="130.0" text="Editar Seleccionado"/>

    <Button fx:id="eliminarButton" layoutX="320.0" layoutY="510.0" mnemonicParsing="false" onAction="#onEliminar"
            prefHeight="30.0" prefWidth="100.0" style="-fx-background-color: #d9534f; -fx-text-fill: white;"
            text="Eliminar"/>
</AnchorPane>