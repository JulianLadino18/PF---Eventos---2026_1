<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="410.0" prefWidth="1080.0" stylesheets="@../Estilos/Estilos.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.ClientEntranceController">
    <children>
        <BorderPane prefHeight="550.0" prefWidth="800.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

            <top>
                <VBox spacing="8.0" style="-fx-background-color: #f4f4f4; -fx-border-color: #cccccc; -fx-border-width: 0 0 1 0;" BorderPane.alignment="CENTER">
                    <children>
                        <Label styleClass="tittle-dark" text="Selección de Asientos" textFill="#0009ff">
                            <font><Font name="System Bold" size="22.0" /></font>
                        </Label>
                        <HBox spacing="15.0">
                            <Label fx:id="lblEventName" styleClass="text-dark" text="[Nombre Evento]" textFill="#333333"><font><Font name="System Bold" size="14.0" /></font></Label>
                            <Label fx:id="lblEventPlace" styleClass="text-dark" text="[Lugar]" textFill="#666666"><font><Font size="14.0" /></font></Label>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <Label style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-padding: 3 8 3 8; -fx-background-radius: 3;" styleClass="btn" text="Disponible" />
                            <Label style="-fx-background-color: #0009ff; -fx-text-fill: white; -fx-padding: 3 8 3 8; -fx-background-radius: 3;" styleClass="btn" text="Seleccion" />
                            <Label style="-fx-background-color: #9e9e9e; -fx-text-fill: white; -fx-padding: 3 8 3 8; -fx-background-radius: 3;" styleClass="btn" text="No Disponible" />
                        </HBox>
                    </children>
                    <padding><Insets bottom="10.0" left="20.0" right="20.0" top="10.0" /></padding>
                </VBox>
            </top>

            <center>
                <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">
                    <content>
                        <VBox fx:id="vboxMapa" alignment="TOP_CENTER" prefHeight="233.0" prefWidth="818.0" spacing="20.0" style="-fx-padding: 20;">
                        </VBox>
                    </content>
                </ScrollPane>
            </center>

            <right>
                <VBox prefWidth="220.0" spacing="10.0" style="-fx-background-color: #ffffff; -fx-border-color: #dddddd; -fx-border-width: 0 0 0 1; -fx-padding: 15;" BorderPane.alignment="CENTER">
                    <children>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" styleClass="text-dark" text="Carrito" />
                        <ScrollPane fitToWidth="true" prefHeight="350.0" style="-fx-background-color: transparent;">
                            <content>
                                <VBox fx:id="vboxCarrito" spacing="5.0" />
                            </content>
                        </ScrollPane>
                        <Label style="-fx-font-weight: bold; -fx-font-size: 14px;" styleClass="text-dark" text="Total:" />
                        <Label fx:id="lblSubtotal" style="-fx-font-weight: bold; -fx-font-size: 18px;" styleClass="text-dark" text="\$0.0" textFill="#27ae60" />
                    </children>
                </VBox>
            </right>

            <bottom>
                <AnchorPane prefHeight="60.0" prefWidth="800.0" style="-fx-background-color: #eeeeee;" BorderPane.alignment="CENTER">
                    <children>
                        <Button layoutX="20.0" layoutY="12.0" onAction="#onCancel" styleClass="btn" text="Cancelar" textFill="WHITE" />
                        <Button fx:id="btnContinuar" disable="true" layoutX="108.0" layoutY="12.0" onAction="#onContinuarCompra" styleClass="btn" text="Continuar al Pago" />
                    </children>
                </AnchorPane>
            </bottom>

        </BorderPane>
    </children>
</AnchorPane>
