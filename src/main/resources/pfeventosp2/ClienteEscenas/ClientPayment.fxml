<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.ClientPaymentController">
    <children>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <Label text="Finalizar Compra" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>

                <!-- Resumen de la Compra -->
                <VBox spacing="10.0" style="-fx-background-color: #ecf0f1; -fx-padding: 15; -fx-background-radius: 8;">
                    <children>
                        <Label fx:id="lblResumen" text="Cargando resumen..." wrapText="true" />
                        <HBox spacing="10.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-font-size: 16px;" text="Total a Pagar:" />
                                <Label fx:id="lblTotalPagar" style="-fx-font-weight: bold; -fx-font-size: 16px;" text="0" textFill="#27ae60" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Selección de Método -->
                <VBox spacing="10.0">
                    <children>
                        <Label style="-fx-font-weight: bold;" text="Seleccione el Método de Pago:" />
                        <ComboBox fx:id="comboMetodoPago" prefWidth="300.0" promptText="Seleccione su opción preferida..." />
                    </children>
                </VBox>

                <VBox fx:id="vboxCamposDinamicos" spacing="10.0" visible="false" managed="false">
                    <children>
                        <TextField fx:id="txtCampo1" maxWidth="300.0" visible="false" managed="false" />
                        <TextField fx:id="txtCampo2" maxWidth="300.0" visible="false" managed="false" />
                        <TextField fx:id="txtCampo3" maxWidth="300.0" visible="false" managed="false" />
                    </children>
                </VBox>

                <!-- Botones -->
                <HBox alignment="CENTER_RIGHT" spacing="15.0" VBox.vgrow="ALWAYS">
                    <children>
                        <Button onAction="#onCancelar" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-cursor: hand;" text="Cancelar Compra" />
                        <Button onAction="#onPagar" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-cursor: hand; -fx-font-weight: bold;" text="Confirmar y Pagar" />
                    </children>
                    <padding>
                        <Insets top="15.0" />
                    </padding>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>