                  <Font name="System Bold" size="17.0" />
               </font>
            </Button>
         </children>
      </VBox>
      <AnchorPane fx:id="contenedorC" layoutX="328.0" layoutY="95.0" prefHeight="596.0" prefWidth="721.0" />
      <Label layoutX="332.0" layoutY="40.0" text="Pagina Inicio" textFill="RED">
         <font>
            <Font name="System Bold" size="29.0" />
         </font>
      </Label>
   </children>
</AnchorPane>
