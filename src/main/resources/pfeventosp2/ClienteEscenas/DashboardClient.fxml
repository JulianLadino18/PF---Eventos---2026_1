                  <Font name="System Bold" size="23.0" />
               </font>
            </Button>
            <Region prefHeight="227.0" prefWidth="270.0" />
            <Button mnemonicParsing="false" onAction="#onCloseDashboard" prefHeight="50.0" prefWidth="168.0" text="CERRAR SESION" textAlignment="CENTER">
