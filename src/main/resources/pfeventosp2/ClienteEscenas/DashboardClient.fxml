<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="720.0" prefWidth="1080.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.eventos.pfeventosp2.Controller.ClientDashboardController">
   <children>
      <VBox layoutX="23.0" layoutY="30.0" prefHeight="660.0" prefWidth="270.0" style="-fx-background-color: #919399; -fx-alignment: top_center; -fx-spacing: 15;">
         <children>
            <Region prefHeight="80.0" prefWidth="168.0" />
            <Button mnemonicParsing="false" onAction="#onGoEvents" prefHeight="50.0" prefWidth="168.0" text="EVENTOS" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="23.0" />
               </font>
            </Button>
            <Button alignment="TOP_CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onGoHistory" prefHeight="50.0" prefWidth="168.0" text="HISTORIAL" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="23.0" />
               </font></Button>
            <Button mnemonicParsing="false" onAction="#onGoProfile" prefHeight="50.0" prefWidth="168.0" text="PERFIL" textAlignment="CENTER">
